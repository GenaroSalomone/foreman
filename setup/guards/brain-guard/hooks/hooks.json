{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/../deny_brain_writes.py\" || exit 2",
            "timeout": 60,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/../deny_executor_repo_writes.py\" || exit 2",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
